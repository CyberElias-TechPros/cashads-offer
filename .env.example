# ─────────────────────────────────────────────────────────────────────────────
# CashAds configuration. Copy to `.env` (or set in your hosting provider).
# Everything is optional in development: with no DATABASE_URL the API runs an
# embedded Postgres (PGlite) under DATA_DIR and seeds demo data on first start.
# ─────────────────────────────────────────────────────────────────────────────

# ---------- API ----------
NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=4000
# postgres://user:pass@host:5432/cashads  (empty → embedded PGlite)
DATABASE_URL=
DATA_DIR=./data
# 32+ random characters. REQUIRED in production (encrypts secrets at rest, derives keys).
APP_SECRET=
# Public URL of the web app (used in emails when it can't be derived from the request)
PUBLIC_WEB_URL=http://localhost:3000
# Seed demo data / show demo helpers (dev mailbox, demo logins). Defaults: on outside production.
DEMO_MODE=
SEED_ON_START=
WORKER_ENABLED=true
RATE_LIMIT_ENABLED=true
LOG_LEVEL=info

# ---------- Partner networks ----------
# Shared secret for the built-in sandbox partner (random if empty)
SANDBOX_NETWORK_SECRET=

# ---------- Sign-in ----------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---------- Email (Resend). Empty → messages are kept in the outbox / dev mailbox ----------
RESEND_API_KEY=
EMAIL_FROM=CashAds <hello@cashads.app>

# ---------- Payout rails. Empty → sandbox rails ----------
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox
PAYSTACK_SECRET_KEY=

# ---------- Web ----------
# Where the web server reaches the API (server-side only; browsers always use /api on the same origin)
API_INTERNAL_URL=http://127.0.0.1:4000
# Who may embed the site in an iframe (CSP frame-ancestors). Use 'self' in production.
FRAME_ANCESTORS=*
