# Copy to apps/api/.env (loaded automatically) — every value is optional in development.

# ── Server ──────────────────────────────────────────────────────────────────
# NODE_ENV=development
# PORT=4000
# HOST=0.0.0.0
# LOG_LEVEL=info

# ── Database ────────────────────────────────────────────────────────────────
# Leave empty to use embedded Postgres (PGlite) stored in apps/api/.data/pglite.
# DATABASE_URL=postgres://lucrum:lucrum@localhost:5432/lucrum
# PGLITE_DIR=.data/pglite

# ── Security ────────────────────────────────────────────────────────────────
# 32 bytes (64 hex chars) — REQUIRED in production. Encrypts phone numbers,
# payout details, KYC numbers and TOTP secrets at rest (AES-256-GCM).
# Generate: openssl rand -hex 32
# DATA_ENCRYPTION_KEY=
# COOKIE_SECURE=true          # default: true in production
# TRUST_PROXY=true            # behind a load balancer / reverse proxy
# METRICS_TOKEN=              # protects GET /api/metrics (Prometheus)

# ── Public URL (used in emails & referral links; derived from the request if empty)
# APP_URL=https://lucrum.example

# ── Modes ───────────────────────────────────────────────────────────────────
# SANDBOX_MODE=true           # simulated networks, ad network, payout rails, dev inbox
# SEED_DEMO=true              # seed demo members/offers on first boot (sandbox only)
# WORKER_ENABLED=true         # background job worker + scheduler in this process
# SERVE_WEB=false             # serve apps/web/dist from the API (true in production)
# API_DOCS=true               # Swagger UI at /api/docs (default: off in production)

# ── Demo credentials (sandbox seed) ────────────────────────────────────────
# DEMO_EMAIL=demo@lucrum.local
# DEMO_PASSWORD=Demo-earner-2026
# ADMIN_EMAIL=admin@lucrum.local
# ADMIN_PASSWORD=Admin-demo-2026

# ── Real providers (production) ────────────────────────────────────────────
# Enables live Nigerian bank payouts via Paystack Transfers (when SANDBOX_MODE=false).
# Webhook URL to configure in Paystack: https://<your-domain>/api/webhooks/paystack
# PAYSTACK_SECRET_KEY=

# ── Fraud: IP reputation (production) ──────────────────────────────────────
# IP Quality Score API key. Enables live VPN / proxy / datacenter detection at
# sign-up and at the earning entry points (cached 24h per IP, fails open).
# Get one: https://www.ipqualityscore.com/
# IPQS_API_KEY=

# ── Ad & offer networks (see docs/networks.md) ─────────────────────────────
# Setting a network's LUCRUM_NET_*_SECRET activates it on the next boot; without
# credentials the network stays visible-but-paused in Admin → Networks.
# Postback URL for every network:  https://<your-domain>/api/postback/<networkId>
# Rewarded-video SSV URL:          https://<your-domain>/api/ssv/<networkId>
#
# Surveys:
# LUCRUM_NET_CPX_SECRET=            # CPX Research (strongest Africa survey fill)
# LUCRUM_NET_CPX_APP_ID=
# LUCRUM_NET_BITLABS_SECRET=        # BitLabs surveys
# LUCRUM_NET_BITLABS_APP_TOKEN=
# LUCRUM_NET_POLLFISH_TOKEN=        # Pollfish (unsigned — IP allowlist mandatory)
# LUCRUM_NET_POLLFISH_APP_TOKEN=
#
# Offerwalls:
# LUCRUM_NET_TAPJOY_SECRET=  LUCRUM_NET_TAPJOY_APP_ID=
# LUCRUM_NET_ADJOE_SECRET=   LUCRUM_NET_ADJOE_APP_TOKEN=
# LUCRUM_NET_ADGEM_SECRET=   LUCRUM_NET_ADGEM_APP_ID=
# LUCRUM_NET_LOOTABLY_SECRET= LUCRUM_NET_LOOTABLY_APP_TOKEN=
# LUCRUM_NET_MONLIX_SECRET=
# LUCRUM_NET_ADSCEND_SECRET= LUCRUM_NET_ADSCEND_APP_ID=
# LUCRUM_NET_REVU_SECRET=    LUCRUM_NET_REVU_APP_ID=
# LUCRUM_NET_AYET_SECRET=    LUCRUM_NET_AYET_APP_ID=
# LUCRUM_NET_ADGATE_SECRET=
# LUCRUM_NET_UNDRADS_SECRET= LUCRUM_NET_UNDRADS_APP_TOKEN=
# LUCRUM_NET_NOTIK_SECRET=   LUCRUM_NET_NOTIK_APP_ID=
# LUCRUM_NET_TIMEWALL_SECRET= LUCRUM_NET_TIMEWALL_APP_TOKEN=
#
# Rewarded video (SSV-verified; strongest on the Android app).
# NOTE: AdMob/AdSense are policy-restricted for cash-reward apps (paying users real
# money for ad engagement = invalid traffic → account termination). Do NOT enable
# admob for Lucrum. The networks below explicitly allow incentivized traffic.
# AppLovin MAX, Pangle and Yango are compiled into apps/android (native SDK);
# each also needs its mobile SDK credentials here (public client credentials):
# LUCRUM_NET_APPLOVIN_SSV_SECRET=    LUCRUM_NET_APPLOVIN_SDK_KEY=    LUCRUM_NET_APPLOVIN_AD_UNIT_ID=
# LUCRUM_NET_PANGLE_SSV_SECRET=      LUCRUM_NET_PANGLE_APP_ID=      LUCRUM_NET_PANGLE_AD_UNIT_ID=
# LUCRUM_NET_YANGO_SSV_SECRET=       LUCRUM_NET_YANGO_APP_ID=       LUCRUM_NET_YANGO_AD_UNIT_ID=
# LUCRUM_NET_LEVELPLAY_SSV_SECRET=   LUCRUM_NET_LEVELPLAY_APP_ID=  LUCRUM_NET_LEVELPLAY_AD_UNIT_ID=
# LUCRUM_NET_VUNGLE_SSV_SECRET=      LUCRUM_NET_VUNGLE_APP_ID=     LUCRUM_NET_VUNGLE_AD_UNIT_ID=
# LUCRUM_NET_MINTEGRAL_SSV_SECRET=   LUCRUM_NET_MINTEGRAL_APP_ID=  LUCRUM_NET_MINTEGRAL_AD_UNIT_ID=
# LUCRUM_NET_FYBER_SSV_SECRET=       LUCRUM_NET_FYBER_APP_ID=      LUCRUM_NET_FYBER_AD_UNIT_ID=
# LUCRUM_NET_CHARTBOOST_SSV_SECRET=  LUCRUM_NET_CHARTBOOST_APP_ID= LUCRUM_NET_CHARTBOOST_APP_SIGNATURE= LUCRUM_NET_CHARTBOOST_AD_UNIT_ID=
# LUCRUM_NET_INMOBI_TOKEN=           LUCRUM_NET_INMOBI_APP_ID=     LUCRUM_NET_INMOBI_AD_UNIT_ID=   # unsigned — IP allowlist mandatory
# LUCRUM_NET_META_TOKEN=             LUCRUM_NET_META_PLACEMENT_ID= # unsigned — IP allowlist mandatory, weak rewarded fill
# LUCRUM_NET_ADMOB_SSV_SECRET=       # ⚠ policy-restricted for cash rewards — do not use
# Optional per-network estimated revenue per video impression (micros, default 50000):
# LUCRUM_NET_APPLOVIN_REVENUE_MICROS= LUCRUM_NET_PANGLE_REVENUE_MICROS= LUCRUM_NET_YANGO_REVENUE_MICROS=
