{
  "name": "lucrum",
  "version": "0.1.0",
  "private": true,
  "description": "Lucrum — the trust-first rewards wallet. Real cash, no points, no minimum, paid even when tracking fails.",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c green,cyan \"npm run dev -w @lucrum/api\" \"npm run dev -w @lucrum/web\"",
    "build": "npm run build -w @lucrum/web && npm run build -w @lucrum/api",
    "start": "npm run start -w @lucrum/api",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "npm run db:generate -w @lucrum/api",
    "db:migrate": "npm run db:migrate -w @lucrum/api",
    "db:seed": "npm run db:seed -w @lucrum/api",
    "db:reset": "npm run db:reset -w @lucrum/api"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "prettier": "^3.6.2",
    "typescript": "~5.9.3"
  }
}
